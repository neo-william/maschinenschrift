# Hugo build output
public/
resources/_gen/
.hugo_build.lock

# Deploy-Artefakte (Direkt-Upload-Zips)
*.zip

# Bridge-generated content (regenerated from works/ at each build)
content/werke/*.md
# ... aber die Sektionsseiten sind handgeschrieben und muessen mit ins Repo,
# sonst fehlen sie im Cloudflare-Build (frischer Clone) und /catalog/ faellt weg.
!content/werke/_index.md
!content/werke/_index.de.md

# Generator-produced static assets (regenerated from siegel-generator/ at each build)
static/siegel/assets/*.svg
static/siegel/assets/*.png

# Python
__pycache__/
*.pyc

# Editor/OS
.DS_Store
Thumbs.db
.vscode/
.idea/
